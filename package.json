{
  "name": "lostcomma-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsx scripts/build.ts",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "i18n": "tsx scripts/i18n.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run i18n -- --check && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/anybody": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@playwright/test": "1.56.0",
    "@types/node": "^22.20.5",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
