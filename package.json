{
  "name": "lostcomma-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsx scripts/build.ts",
    "start": "node dist/server/index.js",
    "preview": "npm run build && node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "i18n": "tsx scripts/i18n.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/cli.ts migrate",
    "db:seed": "tsx src/server/cli.ts seed",
    "media": "tsx src/server/cli.ts media",
    "bookings": "tsx src/server/cli.ts bookings",
    "mail": "tsx src/server/cli.ts mail",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run i18n -- --check && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^10.1.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fontkit": "^2.0.4",
    "markdown-it": "^14.3.3",
    "nodemailer": "^7.0.13",
    "pg": "8.16",
    "sharp": "^0.35.5",
    "wawoff2": "^2.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.13",
    "@fontsource-variable/anybody": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@playwright/test": "1.56.0",
    "@types/fontkit": "^2.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.23.1",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
