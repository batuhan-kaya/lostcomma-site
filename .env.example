NODE_ENV=production
HOST=0.0.0.0
PORT=3000
SITE_URL=https://lostcomma.co
DATA_DIR=/app/data
BRIEF_LIMIT=5
# Calls booked on the Start page per address per hour.
BOOK_LIMIT=3
# Mail for briefs and bookings. Empty: nothing is sent and messages wait in the outbox table.
# smtps://user:pass@smtp.example.com:465 · smtp://user:pass@smtp.example.com:587 · log:// prints them
MAIL_URL=
MAIL_FROM=Lost Comma <hello@lostcomma.co>
MAIL_TO=hello@lostcomma.co
# Video link for calls · {ticket} becomes the booking's token. Empty: we send the link by hand.
# MEET_URL=https://meet.jit.si/lostcomma-{ticket}
# Use letters and digits only: it goes into a URL. openssl rand -hex 24 makes a good one.
POSTGRES_PASSWORD=changeme
# Set by docker-compose.yml from POSTGRES_PASSWORD. Outside Docker:
# DATABASE_URL=postgres://lostcomma:<password>@localhost:5432/lostcomma
# Content for an empty database: none (production) · sample · demo
SEED=none
