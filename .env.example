NODE_ENV=production
HOST=0.0.0.0
PORT=3000
SITE_URL=https://lostcomma.co
DATA_DIR=/app/data
BRIEF_LIMIT=5
# Use letters and digits only: it goes into a URL. openssl rand -hex 24 makes a good one.
POSTGRES_PASSWORD=changeme
# Set by docker-compose.yml from POSTGRES_PASSWORD. Outside Docker:
# DATABASE_URL=postgres://lostcomma:<password>@localhost:5432/lostcomma
# Content for an empty database: none (production) · sample · demo
SEED=none
